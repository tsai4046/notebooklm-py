# NotebookLM Slack Bot — Environment Variables
# 複製此檔案為 ~/.notebooklm/.env.slack 並填入你的值
# Copy this file to ~/.notebooklm/.env.slack and fill in your values

# =============================================================================
# Required
# =============================================================================

# Slack Bot Token (xoxb-...)
# From: api.slack.com/apps → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Slack App-level Token (xapp-...)
# From: api.slack.com/apps → Basic Information → App-Level Tokens
# Requires connections:write scope
SLACK_APP_TOKEN=xapp-your-app-token-here

# Anthropic API Key
# From: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# =============================================================================
# Optional
# =============================================================================

# Default notebook ID when a channel has no per-channel configuration
# Find it in the NotebookLM URL: notebooklm.google.com/notebook/<ID>
# NOTEBOOKLM_NOTEBOOK_ID=your-notebook-id

# Custom home directory for NotebookLM config files (default: ~/.notebooklm)
# NOTEBOOKLM_HOME=/custom/path

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# NOTEBOOKLM_LOG_LEVEL=INFO
